# Nullain Agent SDK Configuration Example

ollama_base_url = "https://ollama.com"

# Per-run budget/limits (M18). max_tokens is a CUMULATIVE ceiling across every
# step of one run, not a per-message limit — 2,000,000 is sized for real
# multi-file feature work, several rounds of self-correction, and debugging a
# larger codebase, not just a single quick answer. Set max_tokens to a smaller
# number to cap cost more tightly, or to an explicit `null` to disable the
# token ceiling entirely (the run is then bounded only by max_steps/timeout —
# a genuinely stuck loop is still caught by loop detection and max_steps, not
# by token spend). `nullain run --max-tokens N` / `--unlimited-tokens` /
# `--max-steps N` override this per invocation without editing the file.
[agent]
max_steps = 100
max_tokens = 2000000
timeout = 300.0

[router]
fallback_chain = ["deep", "balanced", "fast"]
# Optional model used to classify a task's intent/complexity when the
# deterministic heuristics are not confident (M11.3). When unset, the parser
# stays heuristic-only.
# classifier_model = "deepseek-v4-flash:0731-cloud"

[router.tiers.fast]
# Quick classification / low-complexity tasks.
models = ["deepseek-v4-flash:0731-cloud"]
max_context = 64000

[router.tiers.balanced]
# Most coding tasks land here — pick a model with strong tool-calling and
# long-horizon task handling.
models = ["glm-5.2:cloud"]
max_context = 128000

[router.tiers.deep]
# High-complexity tasks, and anything touching images/computer vision.
models = ["gemma4:31b-cloud"]
max_context = 128000

# Lifecycle hooks. Each entry runs a command (argv list, no shell) and pipes
# the event payload as JSON on stdin. Exit codes:
#   0 = success (stdout attached as additional context)
#   2 = block  (pre_tool skips the tool, pre_compact skips compaction)
#   other = non-blocking failure (logged, execution continues)
# [[hooks.pre_tool]]
# command = ["./hooks/pre_tool.sh"]
# timeout = 30.0
#
# [[hooks.post_tool]]
# command = ["./hooks/post_tool.sh"]
#
# [[hooks.pre_compact]]
# command = ["./hooks/pre_compact.sh"]
#
# [[hooks.stop]]
# command = ["./hooks/stop.sh"]
#

# MCP (Model Context Protocol) servers. Each server is spawned over stdio with
# an explicit argv list (never a shell): [command, *args]. Tools exposed by a
# server are registered as mcp__<server>__<tool>. auto_approve = false (the
# default) gates every MCP tool call through the permission approval loop
# (ASK); set true only for servers you fully trust.
# [mcp.servers.filesystem]
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-filesystem", "/workspace"]
# auto_approve = false
# enabled = true
#
# [mcp.servers.git]
# command = "uvx"
# args = ["mcp-server-git", "--repository", "/workspace"]
# env = { GIT_AUTHOR_NAME = "nullain" }

# LSP (Language Server Protocol) servers (M11.2). Each server is spawned over
# stdio with an explicit argv list (never a shell): [command, *args]. The four
# read-only tools (lsp_diagnostics, lsp_goto_definition, lsp_find_references,
# lsp_hover) route a file to its server by extension -> language -> this map.
# A server that fails to initialize is logged and skipped (fail-soft); an
# unsupported file type or unavailable server surfaces as a ToolResult error.
# [lsp.servers.python]
# command = "pyright-langserver"
# args = ["--stdio"]
# enabled = true
#
# [lsp.servers.typescript]
# command = "typescript-language-server"
# args = ["--stdio"]
# enabled = true

# Plugins (P4.25): signed, SBOM'd, capability-manifested MCP server bundles.
# A plugin's identity, launch command, declared capabilities, tool declarations,
# and SBOM are pinned in a signed manifest (nullain-plugin/0.1). The operator
# config ONLY references the manifest path and narrows the granted capabilities;
# it never carries the launch command (signature covers the command, preventing
# substitution). The loader verifies the signature, intersects the plugin's
# declared capabilities with `allowed_capabilities` (the P4.24 meet), and
# registers the tools as mcp__<plugin>__<tool>.
#
# Fail-closed by default:
#   require_signature = true  => an unsigned or unverified plugin is REFUSED
#   signed plugin + no verifier backend (install nullain-sdk[signing]) => REFUSED
#   tool requires a capability not in (declared ∩ granted) => tool dropped (logged)
#   every tool dropped => plugin REFUSED
# Set require_signature = false ONLY for locally-trusted plugins; unsigned plugins
# then load with a structured warning.
# trusted_keys maps key_id -> base64 Ed25519 public key.
# allowed_capabilities narrows the operator grant (union across all plugins).
# [plugins]
# enabled = true
# require_signature = true
# trusted_keys = { alpha = "base64-ed25519-pubkey..." }
# allowed_capabilities = ["read", "write", "network"]
#
# [plugins.entries.search]
# manifest = "./plugins/search/plugin.json"
# auto_approve = false
# allowed_capabilities = ["read"]   # narrow this plugin's grant further
# enabled = true

# OS-level subprocess sandbox for the bash/git tools. The selector picks the
# platform adapter: landlock (Linux >=5.13), seatbelt (macOS), windows_job
# (Windows), or none. Fail-closed: when required=true and the adapter is
# unavailable on this host, bash/git REFUSE to run rather than executing
# unconfined — the safe default. Set required=false to opt out (run unconfined
# if the adapter is unavailable); set enabled=false to disable isolation entirely.
# allow_paths grants the sandboxed child extra writable paths beyond the workspace
# (e.g. a shared cache). deny_network blocks network access where the adapter
# supports it (landlock >=6.2, seatbelt; windows_job v1 does not enforce it).
[sandbox]
enabled = true
required = true
allow_paths = []
deny_network = true

